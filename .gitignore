# Dependencies
node_modules/

# Test and coverage output. coverage/ is generated by `npm test`, which now
# enforces a coverage threshold, so it must never be committed.
coverage/
.nyc_output/

# Packaged tarballs from `npm pack`
*.tgz

# Secrets. No .env file belongs in this repository; if one is ever needed for
# local development, it stays untracked.
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# Editor and OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
